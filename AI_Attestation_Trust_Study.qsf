his answer?","Choices":{"1":{"Display":"Reject \u2014 do not use the information or take the recommended action."},"2":{"Display":"Verify before taking action or using the information."},"3":{"Display":"Use the information or take the recommended action (do not double-check)."}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"What would you do with this answer?","DataExportTag":"Q39","QuestionID":"QID39"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"What is your gender?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,4,5],"Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Non-binary"},"4":{"Display":"Prefer to self-describe","TextEntry":"true"},"5":{"Display":"Prefer not to say"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Gender","Language":[],"QuestionDescription":"What is your gender?","QuestionID":"QID4","QuestionText":"What is your gender?","QuestionText_Unsafe":"What is your sex?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID40","SecondaryAttribute":"If you acted on this answer and it turned out to be wrong, how serious would the outcome be?","TertiaryAttribute":null,"Payload":{"QuestionText":"If you acted on this answer and it turned out to be wrong, how serious would the outcome be?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you acted on this answer and it turned out to be wrong, how serious would the outcome be?","Choices":{"1":{"Display":"1 (Not serious at all)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 (Extremely serious)"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"If you acted on this answer and it turned out to be wrong, how serious would the outcome be?","DataExportTag":"Q40","QuestionID":"QID40"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID41","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q41","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID41"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID42","SecondaryAttribute":"During the study, you were not told which answers were accurate. The table below gives the correc...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>During the study, you were not told which answers were accurate. The table below gives the correct answer for each question, with its source.<\/p>\n<table style=\"border-collapse:collapse; width:100%; font-size:0.9em\">\n<thead><tr><th style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">#<\/th><th style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Question<\/th><th style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Correct answer<\/th><th style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Source<\/th><\/tr><\/thead>\n<tbody>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">1<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">If I take money out of a traditional IRA before age 59\u00bd and no exception applies, what extra federal tax usually applies?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">The extra federal tax is generally 10% of the taxable part of the early distribution.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Internal Revenue Service \u2014 IRS Publication 590-B, Distributions from Individual Retirement Arrangements (IRAs), section on additional tax on early distributions<br><a href=\"https:\/\/www.irs.gov\/publications\/p590b\">https:\/\/www.irs.gov\/publications\/p590b<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">2<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">What is the maximum total acetaminophen an adult should take in one day from all medicines combined?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">The adult maximum is 4,000 mg in 24 hours from all acetaminophen-containing medicines.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">U.S. Food and Drug Administration \u2014 FDA, Acetaminophen Information, consumer safety information on maximum daily dose<br><a href=\"https:\/\/www.fda.gov\/drugs\/information-drug-class\/acetaminophen-information\">https:\/\/www.fda.gov\/drugs\/information-drug-class\/acetaminophen-information<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">3<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">How long can cooked leftovers stay safely in the refrigerator before I should throw them out?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Cooked leftovers are generally safe in the refrigerator for 3 to 4 days.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">U.S. Department of Agriculture Food Safety and Inspection Service \u2014 USDA FSIS, Leftovers and Food Safety, guidance on refrigerated leftovers<br><a href=\"https:\/\/www.fsis.usda.gov\/food-safety\/safe-food-handling-and-preparation\/food-safety-basics\/leftovers-and-food-safety\">https:\/\/www.fsis.usda.gov\/food-safety\/safe-food-handling-and-preparation\/food-safety-basics\/leftovers-and-food-safety<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">4<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">For important online accounts, which is generally stronger against phishing: a FIDO security key or a text-message code?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">A FIDO security key is generally stronger against phishing than a text-message code.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Cybersecurity and Infrastructure Security Agency \u2014 CISA, Implementing Phishing-Resistant MFA, discussion of FIDO\/WebAuthn authentication<br><a href=\"https:\/\/www.cisa.gov\/resources-tools\/resources\/implementing-phishing-resistant-mfa\">https:\/\/www.cisa.gov\/resources-tools\/resources\/implementing-phishing-resistant-mfa<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">5<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">If I enroll late in Medicare Part B and don\u2019t qualify for a Special Enrollment Period, how is the late enrollment penalty usually figured?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">It is usually 10% for each full 12-month period you could have had Part B but did not, and it usually lasts as long as you have Part B.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Medicare.gov \u2014 Medicare.gov, Avoid late enrollment penalties, Part B late enrollment penalty<br><a href=\"https:\/\/www.medicare.gov\/basics\/costs\/medicare-costs\/avoid-penalties\">https:\/\/www.medicare.gov\/basics\/costs\/medicare-costs\/avoid-penalties<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">6<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">If the IRS mails me a notice of deficiency, how long do I generally have to file a petition with the U.S. Tax Court?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">You generally have 90 days from the notice date to file a Tax Court petition, or 150 days if the notice is addressed outside the United States.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">United States Tax Court \u2014 U.S. Tax Court, Starting a Case, deadline for filing a petition after a notice of deficiency<br><a href=\"https:\/\/www.ustaxcourt.gov\/petitioners_start.html\">https:\/\/www.ustaxcourt.gov\/petitioners_start.html<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">7<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">If an online store can\u2019t ship my order by the promised date, can it just delay the order without asking me?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">No. If it cannot ship on time, it generally must get your consent to the delay or promptly refund your money.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Federal Trade Commission \u2014 FTC, Business Guide to the Mail, Internet, or Telephone Order Merchandise Rule, delayed shipment requirements<br><a href=\"https:\/\/www.ftc.gov\/business-guidance\/resources\/business-guide-ftcs-mail-internet-or-telephone-order-merchandise-rule\">https:\/\/www.ftc.gov\/business-guidance\/resources\/business-guide-ftcs-mail-internet-or-telephone-order-merchandise-rule<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">8<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">For a credit card, how long before the due date must the bill generally be sent or delivered?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">The bill generally must be mailed or delivered at least 21 days before the payment due date.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Consumer Financial Protection Bureau \u2014 CFPB Ask CFPB, How long before my credit card payment due date does the card issuer have to mail or deliver my bill?<br><a href=\"https:\/\/www.consumerfinance.gov\/ask-cfpb\/how-long-before-my-credit-card-payment-due-date-does-the-card-issuer-have-to-mail-or-deliver-my-bill-en-47\/\">https:\/\/www.consumerfinance.gov\/ask-cfpb\/how-long-before-my-credit-card-payment-due-date-does-the-card-issuer-have-to-mail-or-deliver-my-bill-en-47\/<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">9<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">How long does First-Class Mail usually take for letters and postcards in the U.S.?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">First-Class Mail for letters and postcards is generally delivered in 1 to 5 business days.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">United States Postal Service \u2014 USPS, First-Class Mail, delivery standard for letters and postcards<br><a href=\"https:\/\/www.usps.com\/ship\/first-class-mail.htm\">https:\/\/www.usps.com\/ship\/first-class-mail.htm<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">10<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">If I book a U.S. flight directly with an airline at least a week before departure, can I cancel within 24 hours for a full refund?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Yes. If you bought it at least seven days before departure, the airline generally must let you cancel within 24 hours for a full refund.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">U.S. Department of Transportation \u2014 DOT Aviation Consumer Protection, Refunds and 24-hour reservation requirement<br><a href=\"https:\/\/www.transportation.gov\/individuals\/aviation-consumer-protection\/refunds\">https:\/\/www.transportation.gov\/individuals\/aviation-consumer-protection\/refunds<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">11<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">When substituting dried herbs for fresh herbs in a recipe, what ratio should I use?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Use about 1 teaspoon of dried herbs for each 1 tablespoon of fresh herbs.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">University of Nebraska-Lincoln Extension \u2014 Nebraska Extension, using herbs and spices in cooking, fresh-to-dried herb substitution guidance<br><a href=\"https:\/\/food.unl.edu\/article\/use-herbs-and-spices-instead-salt\">https:\/\/food.unl.edu\/article\/use-herbs-and-spices-instead-salt<\/a><\/td><\/tr>\n<tr><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">12<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Which Great Lake has the greatest maximum depth?<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">Lake Superior has the greatest maximum depth, at about 1,332 feet.<\/td><td style=\"border:1px solid #ccc; padding:6px; vertical-align:top\">U.S. Environmental Protection Agency \u2014 EPA, Great Lakes Facts and Figures, maximum depth table<br><a href=\"https:\/\/www.epa.gov\/greatlakes\/great-lakes-facts-and-figures\">https:\/\/www.epa.gov\/greatlakes\/great-lakes-facts-and-figures<\/a><\/td><\/tr>\n<\/tbody><\/table>","DefaultChoices":false,"DataExportTag":"Q42","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"During the study, you were not told which answers were accurate. The table below gives the correc...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID42"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID43","SecondaryAttribute":"Your rights and privacy \u00a0Your participation was voluntary, and your responses are anonymous and c..","TertiaryAttribute":null,"Payload":{"QuestionText":"<ul>\n\t<li>\n\t<h3>Your rights and privacy<\/h3>\n\t<\/li>\n<\/ul>\n&nbsp;Your participation was voluntary, and your responses are anonymous and confidential.<br \/>\nYour data will be stored in a secure database and will not be shared with any third parties.<br \/>\n<br \/>\nThe following safeguards have been put in place:\n<ul>\n\t<li>&nbsp;Anonymous data collection<\/li>\n\t<li>No names are collected<\/li>\n\t<li>IP address stripping<\/li>\n\t<li>Age was collected as a&nbsp;range<\/li>\n\t<li>No participant-identifying info is collected or stored<\/li>\n\t<li>Aggregate-only demographic reporting<\/li>\n<\/ul>\n\n<h3>&nbsp;<\/h3>\n\n<h3>Contact information<\/h3>\nIf you have questions about this research, contact the Principal Investigator: Dr. Keith McGreggor &mdash; keith.mcgreggor@gatech.edu.<br \/>\nIf you have questions about your rights as a research participant, you may contact the Georgia Tech Office of Research Integrity Assurance at 404-894-7775<br \/>\n<br \/>\nThank you again for your time and for contributing to this research.","DefaultChoices":false,"DataExportTag":"Q43","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Your rights and privacy \u00a0Your participation was voluntary, and your responses are anonymous and c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID43"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"What is your age range?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your age range?","DefaultChoices":false,"DataExportTag":"Age","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your age range?","Choices":{"1":{"Display":"18\u201324"},"2":{"Display":"25\u201334"},"3":{"Display":"35\u201344"},"4":{"Display":"45\u201354"},"5":{"Display":"55\u201364"},"6":{"Display":"65+"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID5"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"How often do you use AI tools such as chatbots or AI assistants?","TertiaryAttribute":null,"Payload":{"QuestionText":"How often do you use AI tools such as chatbots or AI assistants?","DataExportTag":"AI Use","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How often do you use AI tools such as chatbots or AI assistants?","Choices":{"1":{"Display":"Never"},"2":{"Display":"Monthly"},"3":{"Display":"Weekly"},"4":{"Display":"Daily"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID6"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q7","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Statement 1"},"2":{"Display":"Click to write Statement 2"},"3":{"Display":"Click to write Statement 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"Answers":{"1":{"Display":"Click to write Scale Point 1"},"2":{"Display":"Click to write Scale Point 2"},"3":{"Display":"Click to write Scale Point 3"}},"AnswerOrder":["1","2","3"],"ChoiceDataExportTags":false,"QuestionID":"QID7"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q8","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Strongly Distrust"},"2":{"Display":"Distrust"},"3":{"Display":"Neither Trust nor Distrust"},"4":{"Display":"Trust"},"5":{"Display":"Strongly Trust"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID8"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"In general, how much do you trust AI systems?","TertiaryAttribute":null,"Payload":{"QuestionText":"In general, how much do you trust AI systems?","DefaultChoices":false,"DataExportTag":"Baseline Trust","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"noneAll","Type":"likert","Reverse":false}}},"QuestionDescription":"In general, how much do you trust AI systems?","Choices":{"1":{"Display":"Strongly Distrust"},"2":{"Display":"Distrust"},"3":{"Display":"Neither Trust nor Distrust"},"4":{"Display":"Trust"},"5":{"Display":"Strongly Trust"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID9"}},{"SurveyID":"SV_a4OfOHYGYZU4bbg","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}